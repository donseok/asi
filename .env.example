# Phase 0a MVP는 외부 API 키가 필요 없습니다.
# (pykrx, FinanceDataReader는 무료이며 키가 필요 없습니다.)
#
# 아래는 Phase 0b 이후를 위한 자리표시자입니다.
# 실제 키는 이 파일을 복사한 .env 에만 넣고, .env 는 절대 커밋하지 마세요.
#
#   cp .env.example .env   (Windows: copy .env.example .env)

# Phase 0b — DART 전자공시 OpenAPI (재무제표/공시). https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# Phase 0b — Claude API (AI 요약 리포트). 계산은 코드, 서술만 LLM.
ANTHROPIC_API_KEY=

# Phase 3 — 키움 REST API (국내 실시간 시세). 계좌 + 사용신청 승인 후 발급.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
